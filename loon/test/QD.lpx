#!name=起点读书签到
#!desc=支持多账号对于"起点读书App"的签到功能，默认仅签到，其他任务需手动开启开关。
#!icon=https://is1-ssl.mzstatic.com/image/thumb/Purple221/v4/97/40/5e/97405e49-87bb-3f0a-bf3a-91cf8fdf99a0/AppIcon-0-0-1x_U007epad-0-1-0-0-sRGB-GLES2_U002c0-85-220.png/144x144.png
#!arguments-desc=- 是否开启抓取重写: ["起点读书","#"] \n\n- CRONEXP: 默认每天2点11分执行, 建议自行配置。\n\n- 是否开启调试模式: ["true","false"]\n\n - TIMEOUT: 脚本执行超时时间, 默认60秒。\n\n- 激励任务: ["true","false"]\n\n- 每日任务: ["true","false"]\n\n- 每日抽奖: ["true","false"]\n\n- 每周兑换: ["true","false"]\n\n- 章节卡片: ["true","false"]\n\n- 大咖荐书: ["true","false"]

[Rewrite]
#起点开屏广告（成功）
^https:\/\/magev6\.if\.qidian\.com\/argus\/api\/v4\/client\/getsplashscreen\? response-body-json-jq 'del(.Data.List)' '.Data.EnableGDT="0"'
#url.includes：匹配URL，确定具体接口。
#body.Data.List = null：清空广告列表，阻止广告显示。
#EnableGDT = 0：禁用广点通广告。

#不跳转精选页（没变化）
^https:\/\/magev6\.if\.qidian\.com\/argus\/api\/v2\/deeplink\/geturl response-body-json-jq 'Data.ActionUrl=""'
#修改数据：直接将跳转链接清空，达到阻止跳转的效果。

#去除广告列表（没变化）
^https:\/\/magev6\.if\.qidian\.com\/argus\/api\/v1\/adv\/getadvlistbatch\?positions response-body-json-jq '.Data = []'

#去除每日导读(没变化)
^https:\/\/magev6\.if\.qidian\.com\/argus\/api\/v2\/dailyrecommend\/getdailyrecommend\? response-body-json-jq '.Data=[]'

#去除悬浮书架广告（成功）
^https:\/\/magev6\.if\.qidian\.com\/argus\/api\/v1\/bookshelf\/getHoverAdv response-body-json-jq 'del(.Data.ItemList)'

#去除书架下方猜你喜欢的书（成功）
^https:\/\/magev6\.if\.qidian\.com\/argus\/api\/v1\/dailyrecommend\/recommendBook reject-200

#去除活动弹窗、青少年模式弹窗
^https:\/\/magev6\.if\.qidian\.com\/argus\/api\/v1\/client\/getconf response-body-json-jq '.Data.ActivityPopup=null | .Data.WolfEye=0 | .Data.CloudSetting.TeenShowFreq="0" | .Data.ActivityIcon.StartTime=0 | .Data.ActivityIcon.EndTime=0 | del(.Data.ActivityIcon.Actionurl) | del(.Data.ActivityIcon.Icon) | .Data.EnableSearchUser="1"'
^https:\/\/magev6\.if\.qidian\.com\/argus\/api\/v1\/popup\/batchget response-body-json-jq '.Data.PopupList = []'
#去除青少年模式弹窗
^https:\/\/magev6\.if\.qidian\.com\/argus\/api\/v1\/young\/getconf response-body-json-jq '.Data.TeenShowFreq = 0 | .Data.LimitSeconds = 0 | .Data.Tips = ""'

#删除小说每章后面的推荐
^https:\/\/magev6\.if\.qidian\.com\/argus\/api\/v2\/bookdetail\/chapterending\? response-body-json-jq 'del(.Data.BookList) |del(.Data.Title) |del(.Data.Id)'

#去除起点书架今日导读的背景广告（成功）
^https?:\/\/magev6\.if\.qidian\.com\/argus\/api\/v1\/bookshelf\/getTopOperation$ response-body-json-jq 'del(.Data.Items, .Data.MainInfo)'

[Argument]
CAPTURE_ENABLE=switch,"true","false",tag=是否开启抓取重写, desc=是否开启抓取重写
CRONEXP=input,"11 2 * * *",tag=CRONEXP, desc=默认每天2点11分执行, 建议自行配置。
QDREADER_DEBUG=switch,"false","true",tag=是否开启调试模式, desc=是否开启调试模式
TIMEOUT=input,60,tag=脚本执行超时时间, 默认60秒, desc=TIMEOUT
QDREADER_ADV_JOB_ENABLE=switch,"false","true",tag=激励任务, desc=开启后执行激励碎片任务
QDREADER_EXTRA_ADV_JOB_ENABLE=switch,"false","true",tag=每日任务, desc=开启后执行每日广告任务
QDREADER_LOTTERY_ENABLE=switch,"false","true",tag=每日抽奖, desc=开启后执行每日抽奖
QDREADER_WEEKLY_EXCHANGE_ENABLE=switch,"false","true",tag=每周兑换, desc=开启后周日自动兑换章节卡
QDREADER_CHAPTER_CARD_ENABLE=switch,"false","true",tag=章节卡片, desc=开启后查询章节卡信息
QDREADER_MESSAGE_BOX_ENABLE=switch,"false","true",tag=大咖荐书, desc=开启后处理大咖荐书消息

[Script]
http-response ^https?:\/\/h5\.if\.qidian\.com\/argus\/api\/v1\/user\/getlogininfo script-path=https://raw.githubusercontent.com/CDKe-2022/Loon-learn/refs/heads/main/loon/test/QD.js, requires-body=1, tag=起点读书获取Cookie, enable={CAPTURE_ENABLE}, argument=[{QDREADER_DEBUG}]

cron {CRONEXP} script-path=https://raw.githubusercontent.com/CDKe-2022/Loon-learn/refs/heads/main/loon/test/QD.js, timeout={TIMEOUT}, tag=起点读书自动签到, argument=[{QDREADER_DEBUG},{QDREADER_ADV_JOB_ENABLE},{QDREADER_EXTRA_ADV_JOB_ENABLE},{QDREADER_LOTTERY_ENABLE},{QDREADER_WEEKLY_EXCHANGE_ENABLE},{QDREADER_CHAPTER_CARD_ENABLE},{QDREADER_MESSAGE_BOX_ENABLE}]

[MITM]
hostname = h5.if.qidian.com
