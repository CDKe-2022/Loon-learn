#!name = 赵云与阿斗
#!desc = 赵云与阿斗小游戏辅助工具。仅供测试与体验使用，请勿用于商业用途。频道：叮当猫脚本分享频道 @ddm1023
#!author = @ddm1023
#!homepage = https://t.me/ddm1023
#!icon = https://raw.githubusercontent.com/chxm1023/Script_X/main/icon/zyyad.png
#!system = iOS
#!loon_version = 3.5.1(983)
#!tag = 游戏,辅助
#!type = normal

# ==============================================================================
# 说明：本插件使用 Loon 3.5.1(983) 起的新版 Script 语法
#       request / response 统一为：<阶段> if <条件> then script(<路径>, <参数>) with <属性>
#       插件参数以 ${参数名} 引用，对象参数 {${a},${b}} 会作为 $argument Object 传入脚本
#       如仍在使用 3.5.1(982) 及更早版本，请改用旧语法（script-path=..., argument=[{a},{b}]）
# ==============================================================================

[Argument]

# ============================================================
# 总开关
# ============================================================

ddm_app_switch = switch,true,tag=⚡ 脚本总开关,desc=关闭后本插件内所有脚本都不执行


# ============================================================
# 基础模块开关
# ============================================================

ddm_zyyad_forcevalue = switch,false,tag=强制覆盖模式,desc=关闭：只补不降；开启：完全按照配置覆盖
ddm_zyyad_enablegold = switch,true,tag=💰 金币模块,desc=开启金币修改
ddm_zyyad_enablelevel = switch,true,tag=⭐ 等级模块,desc=开启等级、章节、胜利次数修改
ddm_zyyad_enableregister = switch,true,tag=📅 注册时间模块,desc=开启账号注册时间修改
ddm_zyyad_enableweapon = switch,true,tag=⚔️ 武器模块,desc=开启武器修改
ddm_zyyad_enableskill = switch,true,tag=📜 技能模块,desc=开启技能修改
ddm_zyyad_enableavatar = switch,true,tag=🖼️ 头像模块,desc=解锁全部头像


# ============================================================
# 数值设置（type=number，脚本内直接拿到数字，无需再转换）
# ============================================================

ddm_zyyad_gold = input,9999999,type=number,tag=金币数量,desc=目标金币数量
ddm_zyyad_level = input,999,type=number,tag=等级,desc=目标角色等级
ddm_zyyad_registerday = input,7,type=number,tag=注册天数,desc=设置为距今天指定天数以前注册
ddm_zyyad_weaponcount = input,50,type=number,tag=武器碎片数量,desc=仅在「补充已有武器」模式下生效，作为碎片下限


# ============================================================
# 武器模式
# ============================================================

ddm_zyyad_weaponmode = select,"导入全部武器","关闭","补充已有武器",tag=⚔️ 武器模式,desc=选择武器处理方式


# ============================================================
# 主动技能
# ============================================================

ddm_zyyad_active1 = select,"神兵符","关闭","毛笔","练兵符","神兵符","包子","御敌千里","砚台","陷阱","地雷","速攻符","垃圾桶",tag=主动技能 1,desc=选择第一个主动技能
ddm_zyyad_active2 = select,"速攻符","关闭","毛笔","练兵符","神兵符","包子","御敌千里","砚台","陷阱","地雷","速攻符","垃圾桶",tag=主动技能 2,desc=选择第二个主动技能


# ============================================================
# 被动技能
# ============================================================

ddm_zyyad_passive1 = select,"降妖符","关闭","降妖符","农民","招贤榜","攻速符（全体）","齐头并进","续命丹","大补丸","泥潭","洛阳铲","召唤陨石","升职令","摸金校尉",tag=被动技能 1,desc=选择第一个被动技能
ddm_zyyad_passive2 = select,"农民","关闭","降妖符","农民","招贤榜","攻速符（全体）","齐头并进","续命丹","大补丸","泥潭","洛阳铲","召唤陨石","升职令","摸金校尉",tag=被动技能 2,desc=选择第二个被动技能
ddm_zyyad_passive3 = select,"招贤榜","关闭","降妖符","农民","招贤榜","攻速符（全体）","齐头并进","续命丹","大补丸","泥潭","洛阳铲","召唤陨石","升职令","摸金校尉",tag=被动技能 3,desc=选择第三个被动技能
ddm_zyyad_passive4 = select,"齐头并进","关闭","降妖符","农民","招贤榜","攻速符（全体）","齐头并进","续命丹","大补丸","泥潭","洛阳铲","召唤陨石","升职令","摸金校尉",tag=被动技能 4,desc=选择第四个被动技能
ddm_zyyad_passive5 = select,"洛阳铲","关闭","降妖符","农民","招贤榜","攻速符（全体）","齐头并进","续命丹","大补丸","泥潭","洛阳铲","召唤陨石","升职令","摸金校尉",tag=被动技能 5,desc=选择第五个被动技能
ddm_zyyad_passive6 = select,"摸金校尉","关闭","降妖符","农民","招贤榜","攻速符（全体）","齐头并进","续命丹","大补丸","泥潭","洛阳铲","召唤陨石","升职令","摸金校尉",tag=被动技能 6,desc=选择第六个被动技能


[Script]

# ==============================================================================
# 脚本统一说明
#   · 脚本路径如需国内可访问，可把 raw.githubusercontent.com 地址替换为：
#     https://cdn.jsdelivr.net/gh/CDKe-2022/Loon-learn@main/loon/JieSuo/zhaoyun.js
#   · {${...}} 为插件对象参数，脚本内通过 $argument.ddm_zyyad_gold 等方式读取
#   · enable=${ddm_app_switch} 由「⚡ 脚本总开关」控制，可一键停用全部规则
# ==============================================================================

# 登录响应
response if ${url} ~= /^https?:\/\/.*\.mihuangame\.com\/api\/v\d+\/sys\/user\/login/i then script("https://raw.githubusercontent.com/CDKe-2022/Loon-learn/refs/heads/main/loon/JieSuo/zhaoyun.js", {${ddm_zyyad_forcevalue},${ddm_zyyad_enablegold},${ddm_zyyad_gold},${ddm_zyyad_enablelevel},${ddm_zyyad_level},${ddm_zyyad_enableregister},${ddm_zyyad_registerday},${ddm_zyyad_enableweapon},${ddm_zyyad_weaponmode},${ddm_zyyad_weaponcount},${ddm_zyyad_enableskill},${ddm_zyyad_enableavatar},${ddm_zyyad_active1},${ddm_zyyad_active2},${ddm_zyyad_passive1},${ddm_zyyad_passive2},${ddm_zyyad_passive3},${ddm_zyyad_passive4},${ddm_zyyad_passive5},${ddm_zyyad_passive6}}) with enable=${ddm_app_switch}, tag="赵云与阿斗-登录", requires_body=true

# 用户数据请求体
request if ${url} ~= /^https?:\/\/.*\.mihuangame\.com\/api\/v\d+\/sys\/user\/data/i then script("https://raw.githubusercontent.com/CDKe-2022/Loon-learn/refs/heads/main/loon/JieSuo/zhaoyun.js", {${ddm_zyyad_forcevalue},${ddm_zyyad_enablegold},${ddm_zyyad_gold},${ddm_zyyad_enablelevel},${ddm_zyyad_level},${ddm_zyyad_enableregister},${ddm_zyyad_registerday},${ddm_zyyad_enableweapon},${ddm_zyyad_weaponmode},${ddm_zyyad_weaponcount},${ddm_zyyad_enableskill},${ddm_zyyad_enableavatar},${ddm_zyyad_active1},${ddm_zyyad_active2},${ddm_zyyad_passive1},${ddm_zyyad_passive2},${ddm_zyyad_passive3},${ddm_zyyad_passive4},${ddm_zyyad_passive5},${ddm_zyyad_passive6}}) with enable=${ddm_app_switch}, tag="赵云与阿斗-数据请求", requires_body=true

# 用户数据响应体
response if ${url} ~= /^https?:\/\/.*\.mihuangame\.com\/api\/v\d+\/sys\/user\/data/i then script("https://raw.githubusercontent.com/CDKe-2022/Loon-learn/refs/heads/main/loon/JieSuo/zhaoyun.js", {${ddm_zyyad_forcevalue},${ddm_zyyad_enablegold},${ddm_zyyad_gold},${ddm_zyyad_enablelevel},${ddm_zyyad_level},${ddm_zyyad_enableregister},${ddm_zyyad_registerday},${ddm_zyyad_enableweapon},${ddm_zyyad_weaponmode},${ddm_zyyad_weaponcount},${ddm_zyyad_enableskill},${ddm_zyyad_enableavatar},${ddm_zyyad_active1},${ddm_zyyad_active2},${ddm_zyyad_passive1},${ddm_zyyad_passive2},${ddm_zyyad_passive3},${ddm_zyyad_passive4},${ddm_zyyad_passive5},${ddm_zyyad_passive6}}) with enable=${ddm_app_switch}, tag="赵云与阿斗-数据响应", requires_body=true

# 分享接口
response if ${url} ~= /^https?:\/\/.*\.mihuangame\.com\/toutiaoGame\/ZhaoYunAndADou/i then script("https://raw.githubusercontent.com/CDKe-2022/Loon-learn/refs/heads/main/loon/JieSuo/zhaoyun.js", {${ddm_zyyad_forcevalue},${ddm_zyyad_enablegold},${ddm_zyyad_gold},${ddm_zyyad_enablelevel},${ddm_zyyad_level},${ddm_zyyad_enableregister},${ddm_zyyad_registerday},${ddm_zyyad_enableweapon},${ddm_zyyad_weaponmode},${ddm_zyyad_weaponcount},${ddm_zyyad_enableskill},${ddm_zyyad_enableavatar},${ddm_zyyad_active1},${ddm_zyyad_active2},${ddm_zyyad_passive1},${ddm_zyyad_passive2},${ddm_zyyad_passive3},${ddm_zyyad_passive4},${ddm_zyyad_passive5},${ddm_zyyad_passive6}}) with enable=${ddm_app_switch}, tag="赵云与阿斗-分享", requires_body=true

[Mitm]
hostname = *.mihuangame.com