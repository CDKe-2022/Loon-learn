#!name = 顺丰签到
#!desc = 每日顺丰签到以及Cookie获取（微信小程序 V2 签到体系）
#!author = CDKe-2022
#!openUrl = https://github.com/CDKe-2022/Loon-learn
#!homepage = https://github.com/CDKe-2022/Loon-learn
#!icon = https://raw.githubusercontent.com/CDKe-2022/Loon-learn/main/icon/sunfeng.png
#!system = iOS, iPadOS, tvOS, macOS
#!system_version = 17
#!loon_version = 3.2.1(379)
#!tag = 签到
#!date = 2026-08-22

[Script]
# Cookie获取：匹配 integralSignV2Service 下所有请求（查询/签到接口共用凭证）
http-response ^https:\/\/mcs-mimp-web\.sf-express\.com\/mcs-mimp\/commonPost\/~memberNonactivity~integralSignV2Service~.+ script-path=https://raw.githubusercontent.com/CDKe-2022/Loon-learn/refs/heads/main/loon/JieSuo/shunfeng.js, requires-body=true, timeout=60, tag=顺丰速运获取token, img-url=https://raw.githubusercontent.com/CDKe-2022/Loon-learn/main/icon/sunfeng.png

# 每日自动签到
cron "5 9 * * *" script-path=https://raw.githubusercontent.com/CDKe-2022/Loon-learn/refs/heads/main/loon/JieSuo/shunfeng.js, timeout=60, tag=顺丰每日签到, img-url=https://raw.githubusercontent.com/CDKe-2022/Loon-learn/main/icon/sunfeng.png

[Mitm]
hostname = mcs-mimp-web.sf-express.com
