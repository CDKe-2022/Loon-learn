#!name=Loon 节点订阅解析器
#!desc = 资源解析器，在节点订阅页选择本插件后生效。参数填法：exclude 黑名单填 剩余流量|过期|官网；filter 白名单填 香港|日本|美国；emoji 选 true 清全部表情或 flag 只留国旗；pre 改名前缀填 {flag}；suf 改名后缀填 {index}；rename 替换规则填 香港:HK,美国:US（多条用英文逗号分隔，正则写法 regex:/^\d+[.].+/:，冒号逗号前加反斜杠转义）；sort 地区顺序填 香港|日本|美国（sortBy 为 keyword 时生效）；sortBy 排序可选 name 按节点名 / type 按协议 / area 按国旗 / random 随机；dedup 去重可选 name 按名 / server 按地址 / strict 完整配置；limit 上限填数字如 100；refetch 开启后 userAgent 填订阅商要求的 UA 如 clash-verge/v1.5.11；extra 高级参数填 k=v&k=v，支持 filterRegex includeType typeOrder indexStart retry timeout headers text，示例 indexStart=10&fallback=false；完整说明见脚本文件头注释；排错先开 debug 再到日志页搜「解析器」
#!author=mc2u[https://github.com/mc2u]
#!tag=解析器,节点,订阅
#!system=
#!system_version=
#!loon_version=3.5.0(969)
#!homepage=https://github.com/mc2u/Loon
#!icon=https://raw.githubusercontent.com/Loon0x00/Loon0x00.github.io/main/static/img/loon.png
#!date=2026-08-30 09:20:00
#!type=parser

[Argument]
exclude = input,"",tag=①过滤黑名单关键词，多项用竖线分隔,desc=命中即剔除；多项用竖线分隔：剩余流量|过期|官网
filter = input,"",tag=①保留白名单关键词，多项用竖线分隔,desc=只保留命中节点；多项用竖线分隔：香港|日本|美国
emoji = select,"不动","清除全部","只留旗帜",tag=①emoji 处理false=不动；true=清除全部，flag=只保留国旗,desc=false=不动；true=清除全部emoji；flag=只保留国旗（改名模板用 flag 时选 flag）
rename = input,"",tag=②改名·替换规则,desc=多条规则用英文逗号分隔；普通 香港:HK ；精确 exact:原名:新名 ；正则 regex:/^\d+[.].+/: ；冒号和逗号需转义（前面加反斜杠）
pre = input,"",tag=②改名·统一前缀,desc=支持模板 {flag} {index} {name} {type} {server}；示例 {flag}
suf = input,"",tag=②改名·统一后缀,desc=支持模板 {index} {name} {type} {server} {flag}；示例 {index}
sortBy = select,"keyword","name","type","area","random","none",tag=③排序·方式,desc=keyword=按地区关键词顺序；name=按节点名；type=按协议；area=按国旗地区；random=随机；none=不排序
sort = input,"",tag=③排序·地区关键词,desc=多项用竖线分隔：香港|日本|美国；减号开头排到最后：-美国；留空=按内置地区顺序
sortOrder = select,"asc","desc",tag=③排序·方向,desc=asc=正序；desc=倒序
dedup = select,"off","name","server","strict",tag=④去重,desc=off=不去重；name=按节点名；server=按协议+地址+端口；strict=按完整配置
limit = input,"",tag=④最多保留节点数,desc=排序后截取；留空=不限制；示例 100
refetch = switch,false,tag=⑤重新拉取订阅,desc=开启后用下方 UA 重新拉取原始订阅（不开=直接处理 Loon 传入的内容）
userAgent = input,"",tag=⑤自定义 User-Agent,desc=订阅商按 UA 下发不同格式时的关键参数；示例 clash-verge/v1.5.11 ；需开启上方开关
noCache = switch,false,tag=⑤禁用缓存,desc=拉取时附带 Cache-Control: no-cache
debug = switch,false,tag=⑥调试日志,desc=在 Loon 日志页输出格式识别、参数接收、过滤排序明细
extra = input,"",tag=⑥高级参数,desc=低频参数从这里填；格式 k=v&k=v；支持 filterRegex excludeRegex includeType excludeType typeOrder indexStart retry timeout headers fallback text；示例 indexStart=10&fallback=false

[Script]
generic then script("https://raw.githubusercontent.com/CDKe-2022/Loon-learn/refs/heads/main/loon/resource/loon_resource_parser.js", {${exclude}, ${filter}, ${emoji}, ${rename}, ${pre}, ${suf}, ${sortBy}, ${sort}, ${sortOrder}, ${dedup}, ${limit}, ${refetch}, ${userAgent}, ${noCache}, ${debug}, ${extra}}) with tag="资源解析器", timeout=120
