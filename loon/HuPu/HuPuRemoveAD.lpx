#!name=虎扑去广告
#!desc=移除虎扑开屏广告、首页顶部推广、我的页面多余模块及各类横幅推广。
#!author=ZenmoFeiShi[https://github.com/ZenmoFeiShi]
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/HUPU.png
#!openUrl=https://apps.apple.com/app/id906632439
#!tag=去广告
#!loon_version=3.5.1(978)
#!homepage=https://hub.kelee.one
#!date=2026-08-04

[Rewrite]

########################################
# games.mobileapi.hupu.com
########################################

# ---------- Request ----------

# 去红点
request if
${host} == "games.mobileapi.hupu.com" &&
${path} ~= /^\/\d\/\d+\.\d+\.\d+\/bplapi\/reddot\/v1\/app\/getReddot$/i
then reject_dict(200)

# 去搜索热词
request if
${host} == "games.mobileapi.hupu.com" &&
${path} ~= /^\/\d\/\d+\.\d+\.\d+\/search\/v2\/(hintkeylist|hotkeylist)$/i
then reject_dict(200)

# 比赛页广告
request if
${host} == "games.mobileapi.hupu.com" &&
${path} ~= /^\/\d\/\d+\.\d+\.\d+\/bplcommentapi\/bpl\/score_tab\/groups$/i
then reject_dict(200)

request if
${host} == "games.mobileapi.hupu.com" &&
${path} ~= /^\/\d\/\d+\.\d+\.\d+\/bplapi\/banner\/getLocationBanners$/i
then reject_dict(200)

# ---------- Response ----------

# 首页顶部 Banner
response if
${host} == "games.mobileapi.hupu.com" &&
${path} ~= /^\/\d\/\d+\.\d+\.\d+\/buffer\/hotList$/i
then response.json.jq("del(.result.topBanner)")

# 我的页面 VIP
response if
${host} == "games.mobileapi.hupu.com" &&
${path} ~= /^\/\d\/\d+\.\d+\.\d+\/bplapi\/user\/v1\/more$/i
then response.json.jq("del(.result.vipInfo)")

########################################
# bbs.mobileapi.hupu.com
########################################

# ---------- Request ----------

# 热榜
request if
${host} == "bbs.mobileapi.hupu.com" &&
${path} ~= /^\/\d\/\d+\.\d+\.\d+\/bbsallapi\/tag\/v1\/heatTag$/i
then reject_dict(200)

request if
${host} == "bbs.mobileapi.hupu.com" &&
${path} ~= /^\/\d\/\d+\.\d+\.\d+\/bbsrankapi\/v1\/rating\/list$/i
then reject_dict(200)

# ---------- Response ----------

# 我的页面入口
response if
${host} == "bbs.mobileapi.hupu.com" &&
${path} ~= /^\/\d\/\d+\.\d+\.\d+\/bbsallapi\/lego\/data$/i
then response.json.jq("if .data and .data.cards then (.data.cards[]? | select(.code==\"multiIcon\") | .components |= map(select(.data.title as $t | [\"个性换肤\",\"专家预测\",\"邀请好友\",\"版主中心\",\"JRs战术板\",\"草稿箱\",\"58同城\"] | index($t) | not))) | .data.cards |= map(select((.components[]?.data.title? // \"\") != \"我的应用\")) else . end")

########################################
# fairy.mobileapi.hupu.com
########################################

# ---------- Request ----------

request if
${host} == "fairy.mobileapi.hupu.com" &&
${path} == "/gallery/getmod2"
then reject(200)

# ---------- Response ----------

response if
${host} == "fairy.mobileapi.hupu.com" &&
${path} == "/mang/preview/banners"
then response.json.jq("del(.data)")

########################################
# goblin.hupu.com
########################################

# ---------- Request ----------

request if
${host} == "goblin.hupu.com" &&
${path} ~= /^\/\d\/\d+\.\d+\.\d+\/interfaceAd\/getOther\/v\d+$/i
then reject_dict(200)

request if
${host} == "goblin.hupu.com" &&
${path} ~= /^\/\d\/\d+\.\d+\.\d+\/interfaceAd\/getOther\/batch$/i
then reject_dict(200)

[MITM]
hostname = games.mobileapi.hupu.com, fairy.mobileapi.hupu.com, bbs.mobileapi.hupu.com, goblin.hupu.com